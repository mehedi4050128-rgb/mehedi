<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Md. Mehedi Hassan | Technical Security & Aviation Specialist</title>
  <!-- Google Fonts & Font Awesome 6.5.1 -->
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;800;900&family=JetBrains+Mono:wght@300;400;500;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <style>
    :root {
      --chip-bg: #030712;
      --chip-panel: rgba(10, 17, 34, 0.88);
      --chip-panel-hover: rgba(16, 28, 55, 0.95);
      --neon-cyan: #00f0ff;
      --neon-cyan-glow: rgba(0, 240, 255, 0.35);
      --circuit-gold: #f59e0b;
      --neon-emerald: #10b981;
      --neon-purple: #8b5cf6;
      --wire-border: rgba(0, 240, 255, 0.2);
      --wire-border-active: rgba(0, 240, 255, 0.65);
      --text-main: #f8fafc;
      --text-dim: #94a3b8;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Plus Jakarta Sans', sans-serif;
      scroll-behavior: smooth;
    }

    body {
      background-color: var(--chip-bg);
      color: var(--text-main);
      line-height: 1.65;
      overflow-x: hidden;
      position: relative;
    }

    /* Microchip Circuit Board Grid Canvas */
    #chip-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -1;
      pointer-events: none;
      background: radial-gradient(circle at 50% 50%, #091226 0%, #030712 95%);
    }

    /* Floating Microchip HUD Nav */
    .nav-wrapper {
      position: fixed;
      top: 1.2rem;
      left: 0;
      width: 100%;
      display: flex;
      justify-content: center;
      z-index: 1000;
      padding: 0 1.2rem;
    }

    nav {
      width: 100%;
      max-width: 1200px;
      background: rgba(8, 14, 29, 0.92);
      backdrop-filter: blur(25px);
      border: 1px solid var(--wire-border);
      border-radius: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.65rem 1.6rem;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.8), 0 0 20px rgba(0, 240, 255, 0.1);
      position: relative;
    }

    /* Chip Node Corner Accents */
    nav::before, nav::after {
      content: '';
      position: absolute;
      width: 10px;
      height: 10px;
      border-color: var(--neon-cyan);
      pointer-events: none;
    }
    nav::before { top: -2px; left: -2px; border-top: 2px solid; border-left: 2px solid; }
    nav::after { bottom: -2px; right: -2px; border-bottom: 2px solid; border-right: 2px solid; }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
    }

    .chip-core-icon {
      width: 38px;
      height: 38px;
      border-radius: 8px;
      background: rgba(0, 240, 255, 0.08);
      border: 1.5px solid var(--neon-cyan);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--neon-cyan);
      font-size: 1.1rem;
      box-shadow: 0 0 15px var(--neon-cyan-glow);
    }

    .brand-title {
      font-family: 'Orbitron', sans-serif;
      font-weight: 800;
      font-size: 0.95rem;
      letter-spacing: 1px;
      color: var(--neon-cyan);
      text-shadow: 0 0 10px var(--neon-cyan-glow);
    }

    .brand-sub {
      font-size: 0.65rem;
      font-family: 'JetBrains Mono', monospace;
      color: var(--neon-emerald);
      letter-spacing: 1px;
      font-weight: 600;
    }

    .nav-links {
      display: flex;
      align-items: center;
      list-style: none;
      gap: 0.8rem;
    }

    .nav-item {
      position: relative;
    }

    .nav-link {
      font-family: 'JetBrains Mono', monospace;
      color: var(--text-dim);
      text-decoration: none;
      font-size: 0.82rem;
      font-weight: 500;
      padding: 0.5rem 0.85rem;
      border-radius: 6px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.25s ease;
      cursor: pointer;
    }

    .nav-link:hover, .nav-item:hover > .nav-link {
      color: var(--neon-cyan);
      background: rgba(0, 240, 255, 0.1);
      box-shadow: 0 0 10px rgba(0, 240, 255, 0.2);
    }

    .dropdown-menu {
      position: absolute;
      top: calc(100% + 12px);
      left: 50%;
      transform: translateX(-50%) translateY(10px);
      background: rgba(7, 13, 27, 0.98);
      backdrop-filter: blur(28px);
      border: 1px solid var(--wire-border-active);
      border-radius: 12px;
      padding: 0.8rem;
      min-width: 270px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.9), 0 0 25px rgba(0, 240, 255, 0.15);
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 6px;
      z-index: 1050;
    }

    .nav-item:hover .dropdown-menu {
      opacity: 1;
      visibility: visible;
      transform: translateX(-50%) translateY(0);
    }

    .dropdown-item a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 0.65rem 0.9rem;
      color: var(--text-dim);
      text-decoration: none;
      font-size: 0.82rem;
      font-family: 'JetBrains Mono', monospace;
      border-radius: 8px;
      transition: 0.2s;
    }

    .dropdown-item a:hover {
      color: #ffffff;
      background: rgba(0, 240, 255, 0.15);
      transform: translateX(4px);
    }

    .mobile-menu-btn {
      display: none;
      background: transparent;
      border: 1px solid var(--neon-cyan);
      color: var(--neon-cyan);
      padding: 6px 12px;
      border-radius: 6px;
      font-size: 1.1rem;
      cursor: pointer;
    }

    /* Hero Section */
    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8.5rem 8% 4rem;
      gap: 3.5rem;
    }

    .hero-content {
      flex: 1.3;
    }

    .chip-status-tag {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 6px 16px;
      background: rgba(0, 240, 255, 0.08);
      border: 1px solid var(--wire-border);
      border-radius: 6px;
      font-size: 0.78rem;
      color: var(--neon-cyan);
      margin-bottom: 1.5rem;
      font-family: 'JetBrains Mono', monospace;
      box-shadow: 0 0 15px rgba(0, 240, 255, 0.15);
    }

    .pulse-core {
      width: 8px;
      height: 8px;
      background: var(--neon-emerald);
      border-radius: 50%;
      box-shadow: 0 0 12px var(--neon-emerald);
      animation: pulseAnim 2s infinite;
    }

    @keyframes pulseAnim {
      0% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
      70% { transform: scale(1.1); box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
      100% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    .hero-content h1 {
      font-family: 'Orbitron', sans-serif;
      font-size: 3.4rem;
      font-weight: 900;
      line-height: 1.15;
      letter-spacing: -0.5px;
      margin-bottom: 1rem;
    }

    .chip-gradient {
      background: linear-gradient(135deg, var(--neon-cyan) 0%, #38bdf8 40%, var(--neon-purple) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-shadow: 0 0 35px rgba(0, 240, 255, 0.3);
    }

    .sub-tech-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 1.05rem;
      color: var(--neon-emerald);
      margin-bottom: 1.6rem;
      font-weight: 600;
    }

    .hero-desc {
      font-size: 1.02rem;
      color: var(--text-dim);
      max-width: 600px;
      margin-bottom: 2.2rem;
      line-height: 1.8;
    }

    .btn-group {
      display: flex;
      flex-wrap: wrap;
      gap: 1.2rem;
    }

    .chip-btn {
      padding: 0.9rem 1.8rem;
      border-radius: 8px;
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
      font-size: 0.88rem;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      transition: all 0.3s ease;
      cursor: pointer;
      position: relative;
    }

    .chip-btn-primary {
      background: linear-gradient(135deg, rgba(0, 240, 255, 0.2), rgba(139, 92, 246, 0.25));
      border: 1.5px solid var(--neon-cyan);
      color: var(--neon-cyan);
      box-shadow: 0 0 25px rgba(0, 240, 255, 0.25);
    }

    .chip-btn-primary:hover {
      background: var(--neon-cyan);
      color: #030712;
      box-shadow: 0 0 40px var(--neon-cyan);
      transform: translateY(-3px);
    }

    .chip-btn-glass {
      background: rgba(255, 255, 255, 0.03);
      color: #e2e8f0;
      border: 1px solid var(--wire-border);
    }

    .chip-btn-glass:hover {
      border-color: var(--neon-cyan);
      color: var(--neon-cyan);
      transform: translateY(-3px);
    }

    /* Futuristic Microchip Portrait Socket */
    .hero-visual {
      flex: 0.9;
      display: flex;
      justify-content: center;
      position: relative;
    }

    .chip-socket-frame {
      position: relative;
      width: 340px;
      height: 340px;
      padding: 12px;
      background: rgba(10, 18, 38, 0.7);
      border: 2px solid var(--wire-border);
      border-radius: 20px;
      box-shadow: 0 0 50px rgba(0, 240, 255, 0.2), inset 0 0 20px rgba(0, 240, 255, 0.1);
    }

    /* Microchip Pin Connectors */
    .chip-socket-frame::before {
      content: '';
      position: absolute;
      top: -10px; left: 15%; right: 15%;
      height: 6px;
      background: repeating-linear-gradient(90deg, var(--circuit-gold) 0px, var(--circuit-gold) 6px, transparent 6px, transparent 14px);
    }
    .chip-socket-frame::after {
      content: '';
      position: absolute;
      bottom: -10px; left: 15%; right: 15%;
      height: 6px;
      background: repeating-linear-gradient(90deg, var(--circuit-gold) 0px, var(--circuit-gold) 6px, transparent 6px, transparent 14px);
    }

    .chip-socket-frame img {
      width: 100%;
      height: 100%;
      border-radius: 12px;
      object-fit: cover;
      background: #060c1d;
      display: block;
      border: 2px solid var(--wire-border-active);
    }

    /* Section Styling (Microchip Architecture Modules) */
    section {
      padding: 6.5rem 8%;
      position: relative;
    }

    .section-header {
      text-align: center;
      margin-bottom: 3.8rem;
    }

    .section-module-tag {
      font-family: 'JetBrains Mono', monospace;
      color: var(--neon-emerald);
      font-size: 0.78rem;
      letter-spacing: 2px;
      display: block;
      margin-bottom: 0.5rem;
      font-weight: 600;
    }

    .section-title {
      font-family: 'Orbitron', sans-serif;
      font-size: 2.2rem;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: 0.5px;
    }

    /* Microchip Card Part-by-Part Architecture */
    .chip-module-card {
      background: var(--chip-panel);
      border: 1px solid var(--wire-border);
      border-radius: 16px;
      padding: 2.4rem;
      backdrop-filter: blur(20px);
      position: relative;
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.75);
    }

    /* Circuit Trace Pin lines at top left */
    .chip-module-card::before {
      content: '';
      position: absolute;
      top: 0; left: 25px;
      width: 40px; height: 3px;
      background: var(--neon-cyan);
      box-shadow: 0 0 12px var(--neon-cyan);
    }

    .chip-module-card:hover {
      border-color: var(--wire-border-active);
      background: var(--chip-panel-hover);
      transform: translateY(-6px);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.9), 0 0 30px rgba(0, 240, 255, 0.2);
    }

    /* Core Metrics Dashboard in About */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.5rem;
      margin-top: 2.5rem;
      padding-top: 2rem;
      border-top: 1px solid var(--wire-border);
    }

    .metric-box h3 {
      font-family: 'Orbitron', sans-serif;
      font-size: 2rem;
      font-weight: 800;
      color: var(--neon-cyan);
      text-shadow: 0 0 15px rgba(0, 240, 255, 0.4);
    }

    .metric-box p {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.78rem;
      color: var(--text-dim);
      letter-spacing: 1px;
    }

    /* Experience Circuit Timeline */
    .timeline {
      position: relative;
      max-width: 1000px;
      margin: 0 auto;
    }

    .timeline::before {
      content: '';
      position: absolute;
      left: 20px; top: 0; bottom: 0;
      width: 2px;
      background: linear-gradient(180deg, var(--neon-cyan), var(--neon-purple), var(--circuit-gold), transparent);
      box-shadow: 0 0 12px var(--neon-cyan);
    }

    .timeline-item {
      position: relative;
      padding-left: 65px;
      margin-bottom: 2.8rem;
    }

    .timeline-node {
      position: absolute;
      left: 6px; top: 0;
      width: 30px; height: 30px;
      border-radius: 8px;
      background: #030712;
      border: 2px solid var(--neon-cyan);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--neon-cyan);
      font-size: 0.85rem;
      box-shadow: 0 0 15px var(--neon-cyan);
    }

    .job-top-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 0.4rem;
    }

    .job-title {
      font-family: 'Orbitron', sans-serif;
      font-size: 1.18rem;
      font-weight: 700;
      color: #ffffff;
    }

    .company-title {
      color: var(--neon-cyan);
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.92rem;
      font-weight: 600;
    }

    .job-duration {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.78rem;
      color: var(--neon-emerald);
      background: rgba(16, 185, 129, 0.1);
      border: 1px solid rgba(16, 185, 129, 0.3);
      padding: 4px 12px;
      border-radius: 6px;
      font-weight: 600;
    }

    .job-bullets {
      list-style: none;
      margin-top: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }

    .job-bullets li {
      position: relative;
      padding-left: 22px;
      font-size: 0.94rem;
      color: #cbd5e1;
      line-height: 1.6;
    }

    .job-bullets li::before {
      content: '◆';
      position: absolute;
      left: 0;
      color: var(--neon-cyan);
      font-size: 0.75rem;
    }

    /* Skills Grid */
    .filter-tabs {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 0.8rem;
      margin-bottom: 2.8rem;
    }

    .filter-btn {
      padding: 0.55rem 1.4rem;
      background: rgba(0, 240, 255, 0.04);
      border: 1px solid var(--wire-border);
      border-radius: 8px;
      color: var(--text-dim);
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.82rem;
      cursor: pointer;
      transition: all 0.25s ease;
    }

    .filter-btn.active, .filter-btn:hover {
      background: var(--neon-cyan);
      color: #030712;
      box-shadow: 0 0 25px var(--neon-cyan);
      font-weight: 700;
    }

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 1.8rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    .skill-chip-icon {
      width: 50px;
      height: 50px;
      border-radius: 10px;
      background: rgba(0, 240, 255, 0.08);
      border: 1.5px solid var(--neon-cyan);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--neon-cyan);
      font-size: 1.4rem;
      margin-bottom: 1.2rem;
      box-shadow: 0 0 15px rgba(0, 240, 255, 0.2);
    }

    /* Certifications Grid */
    .cert-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.5rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    /* Terminal Console */
    .terminal-console {
      max-width: 950px;
      margin: 0 auto;
      background: #02050e;
      border: 1px solid var(--wire-border-active);
      border-radius: 16px;
      box-shadow: 0 0 50px rgba(0, 240, 255, 0.25);
      overflow: hidden;
    }

    .terminal-topbar {
      background: rgba(8, 15, 32, 0.95);
      padding: 0.75rem 1.2rem;
      border-bottom: 1px solid var(--wire-border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .terminal-dots { display: flex; gap: 6px; }
    .tdot { width: 10px; height: 10px; border-radius: 50%; }
    .tdot-red { background: #ef4444; }
    .tdot-yellow { background: #eab308; }
    .tdot-green { background: #10b981; }

    .terminal-body {
      padding: 2.2rem;
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      gap: 2.2rem;
    }

    .form-input-tech {
      width: 100%;
      background: rgba(0, 240, 255, 0.03);
      border: 1px solid var(--wire-border);
      border-radius: 8px;
      padding: 0.85rem 1rem;
      color: var(--neon-cyan);
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.88rem;
      outline: none;
      transition: 0.3s;
      margin-top: 0.35rem;
    }

    .form-input-tech:focus {
      border-color: var(--neon-cyan);
      box-shadow: 0 0 20px rgba(0, 240, 255, 0.35);
      background: rgba(0, 240, 255, 0.08);
    }

    /* Modal */
    .modal-overlay {
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background: rgba(3, 7, 18, 0.92);
      backdrop-filter: blur(16px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 2000;
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease;
      padding: 1rem;
    }

    .modal-overlay.active { opacity: 1; visibility: visible; }

    .modal-hud {
      background: #070d1e;
      border: 2px solid var(--neon-cyan);
      border-radius: 16px;
      padding: 2.4rem;
      max-width: 650px;
      width: 100%;
      box-shadow: 0 0 50px rgba(0, 240, 255, 0.35);
      position: relative;
    }

    .modal-close-btn {
      position: absolute;
      top: 1.2rem; right: 1.2rem;
      background: none; border: none;
      color: var(--neon-cyan);
      font-size: 1.3rem;
      cursor: pointer;
    }

    footer {
      text-align: center;
      padding: 2.5rem 8%;
      border-top: 1px solid var(--wire-border);
      color: var(--text-dim);
      font-size: 0.85rem;
      font-family: 'JetBrains Mono', monospace;
    }

    /* Mobile Overrides */
    @media (max-width: 850px) {
      .mobile-menu-btn { display: block; }
      .nav-links {
        position: absolute;
        top: calc(100% + 10px);
        left: 0;
        width: 100%;
        background: rgba(6, 12, 26, 0.98);
        border: 1px solid var(--wire-border);
        border-radius: 12px;
        flex-direction: column;
        padding: 1.2rem;
        gap: 0.5rem;
        display: none;
      }
      .nav-links.active { display: flex; }
      .dropdown-menu {
        position: static;
        transform: none;
        box-shadow: none;
        opacity: 1;
        visibility: visible;
        display: block;
        margin-top: 6px;
        background: rgba(255, 255, 255, 0.02);
      }
      .hero {
        flex-direction: column-reverse;
        text-align: center;
        padding-top: 7.5rem;
      }
      .hero-content h1 { font-size: 2.3rem; }
      .btn-group { justify-content: center; }
      .terminal-body { grid-template-columns: 1fr; }
      .timeline-item { padding-left: 45px; }
      .timeline::before { left: 14px; }
      .timeline-node { left: 0; }
    }
  </style>
</head>
<body>

  <!-- Microchip Circuit Background Canvas -->
  <canvas id="chip-canvas"></canvas>

  <!-- Floating Microchip Navigation -->
  <div class="nav-wrapper">
    <nav>
      <a href="#home" class="brand-logo">
        <div class="chip-core-icon">
          <i class="fa-solid fa-microchip"></i>
        </div>
        <div>
          <span class="brand-title">MEHEDI HASSAN</span><br>
          <span class="brand-sub">SECURITY & TECH SPECIALIST</span>
        </div>
      </a>

      <button class="mobile-menu-btn" onclick="toggleMobileNav()"><i class="fa-solid fa-bars"></i></button>

      <ul class="nav-links" id="mobileNav">
        <li class="nav-item"><a href="#home" class="nav-link" onclick="closeNav()">Home</a></li>
        <li class="nav-item"><a href="#about" class="nav-link" onclick="closeNav()">Overview</a></li>
        
        <li class="nav-item">
          <a class="nav-link">Experience <i class="fa-solid fa-chevron-down"></i></a>
          <ul class="dropdown-menu">
            <li class="dropdown-item"><a href="#experience" onclick="closeNav()">Ulkasemi Pvt. Ltd.</a></li>
